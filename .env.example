# ── Core ─────────────────────────────────────────
# PostgreSQL connection. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://app:app@localhost:5432/app

# JWT signing secret. Change to a strong random string in production.
JWT_SECRET=dev-secret-change-me

# HTTP port
PORT=3000

# ── Setup ────────────────────────────────────────
# Optional. If set, /setup page requires ?secret=<value> to access.
SETUP_SECRET=

# ── Storage ──────────────────────────────────────
# "local" (default) saves uploads to ./uploads
# "s3" uses S3-compatible storage (fill the S3_* vars below)
STORAGE_TYPE=local

# Optional S3-compatible storage (MinIO, Cloudflare R2, AWS S3, etc.)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
