<%- include('layout', { body: `
<h2 style="margin:0 0 16px;color:#111827;font-size:18px;">Order Confirmation</h2>
<p style="color:#374151;line-height:1.6;">
  Thank you for your order! Your order <strong>${order.orderNumber}</strong> has been received.
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden;">
  <tr style="background:#f9fafb;">
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;">Order Number</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;">${order.orderNumber}</td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Total</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">${order.currency} ${Number(order.total).toLocaleString()}</td>
  </tr>
  <tr style="background:#f9fafb;">
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Payment</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Online Payment (Xendit)</td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Expires</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">${new Date(order.expiresAt).toLocaleString()}</td>
  </tr>
</table>

${order.paymentUrl ? '<p style="text-align:center;margin:24px 0;"><a href="' + order.paymentUrl + '" style="display:inline-block;background:#4f46e5;color:#ffffff;padding:12px 32px;border-radius:6px;text-decoration:none;font-weight:600;">Complete Payment</a></p>' : ''}

<p style="color:#6b7280;font-size:13px;line-height:1.5;">
  Please complete your payment before the deadline. If payment is not received, your order will be automatically cancelled.
</p>
` }) %>
