<%- include('layout', { body: `
<h2 style="margin:0 0 16px;color:#111827;font-size:18px;">Order Cancelled</h2>
<p style="color:#374151;line-height:1.6;">
  Your order <strong>${order.orderNumber}</strong> has been cancelled.
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden;">
  <tr style="background:#f9fafb;">
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;">Order Number</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;">${order.orderNumber}</td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Total</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">${Number(order.total).toLocaleString()}</td>
  </tr>
  <tr style="background:#f9fafb;">
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Status</td>
    <td style="padding:12px 16px;font-size:14px;border-top:1px solid #e5e7eb;">
      <span style="background:#fee2e2;color:#991b1b;padding:4px 12px;border-radius:12px;font-size:12px;font-weight:600;">CANCELLED</span>
    </td>
  </tr>
</table>

<p style="color:#6b7280;font-size:13px;line-height:1.5;">
  If you have any questions, please contact us. Any reserved stock has been restored.
</p>
` }) %>
