<%- include('layout', { body: `
<h2 style="margin:0 0 16px;color:#111827;font-size:18px;">Order Confirmation</h2>
<p style="color:#374151;line-height:1.6;">
  Thank you for your order! Your order <strong>${order.orderNumber}</strong> has been received.
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden;">
  <tr style="background:#f9fafb;">
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;">Order Number</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;">${order.orderNumber}</td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Total</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">${order.currency} ${Number(order.total).toLocaleString()}</td>
  </tr>
  <tr style="background:#f9fafb;">
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Payment</td>
    <td style="padding:12px 16px;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Bank Transfer</td>
  </tr>
  <tr>
    <td style="padding:12px 16px;font-weight:600;color:#374151;font-size:14px;border-top:1px solid #e5e7eb;">Deadline</td>
    <td style="padding:12px 16px;color:#ef4444;font-size:14px;font-weight:600;border-top:1px solid #e5e7eb;">${new Date(order.expiresAt).toLocaleString()}</td>
  </tr>
</table>

<h3 style="margin:24px 0 12px;color:#111827;font-size:16px;">Transfer to one of these accounts:</h3>

${bankAccounts.map(b => '<div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:16px;margin-bottom:12px;"><p style="margin:0 0 4px;font-weight:600;color:#111827;">' + b.bankName + '</p><p style="margin:0 0 4px;color:#374151;font-size:14px;">Account: <strong>' + b.accountNumber + '</strong></p><p style="margin:0;color:#6b7280;font-size:13px;">Holder: ' + b.accountHolder + '</p></div>').join('')}

<div style="background:#fef3c7;border:1px solid #f59e0b;border-radius:6px;padding:16px;margin:24px 0;">
  <p style="margin:0;color:#92400e;font-size:14px;font-weight:600;">Important:</p>
  <p style="margin:8px 0 0;color:#92400e;font-size:13px;line-height:1.5;">
    Transfer the exact amount of <strong>${order.currency} ${Number(order.total).toLocaleString()}</strong>.
    After transferring, please upload your payment proof on the order page.
  </p>
</div>
` }) %>
