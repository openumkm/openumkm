<%# Settings: AI Configuration Section %>
<%
var currentModel = s.aiModel || '';
%>
<div class="admin-card mb-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="admin-card-title" style="margin-bottom: 0;"><%= t('admin.ai_config') %></h3>
    <label class="toggle">
      <input type="checkbox" name="aiEnabled" value="1" <%= s.aiEnabled ? 'checked' : '' %>>
      <span class="toggle-track"></span>
      <span class="toggle-label"><%= t('admin.enabled', 'Enabled') %></span>
    </label>
  </div>
  <p style="font: var(--font-body-md); color: var(--color-text-secondary); margin-bottom: var(--space-4);"><%= t('admin.ai_hint', 'Connect an OpenAI-compatible API to generate product descriptions, SEO meta, and more.') %></p>
  <div class="form-group">
    <label for="aiBaseUrl" class="form-label"><%= t('admin.f_ai_url', 'API Base URL') %></label>
    <input type="url" id="aiBaseUrl" name="aiBaseUrl" class="input" value="<%= s.aiBaseUrl || '' %>" placeholder="https://api.openai.com/v1">
  </div>
  <div class="form-group">
    <label for="aiApiKey" class="form-label"><%= t('admin.f_ai_key', 'API Key') %></label>
    <input type="password" id="aiApiKey" name="aiApiKey" class="input" value="<%= s.aiApiKey || '' %>" placeholder="sk-xxxxx">
  </div>

  <div class="form-group">
    <label for="aiModel" class="form-label"><%= t('admin.f_ai_model', 'Model Name') %></label>
    <div class="flex items-center gap-2" style="flex-wrap: wrap;">
      <select id="aiModelSelect" class="select" style="flex: 1; min-width: 220px;">
        <% if (currentModel) { %>
        <option value="<%= currentModel %>" selected><%= currentModel %></option>
        <% } else { %>
        <option value="" selected disabled><%= t('admin.ai_model_placeholder', 'Fetch models or choose custom...') %></option>
        <% } %>
        <option value="__custom__"><%= t('admin.ai_model_custom', 'Custom (enter manually)') %></option>
      </select>
      <button type="button" id="aiFetchModelsBtn" class="btn btn-secondary btn-sm">
        <%= t('admin.ai_fetch_models', 'Fetch Models') %>
      </button>
    </div>
    <input type="text" id="aiModel" name="aiModel" class="input mt-2" value="<%= currentModel %>" placeholder="gpt-4o-mini" style="display: <%= currentModel ? 'none' : 'block' %>;">
    <span id="aiModelStatus" class="form-hint" style="display: none;"></span>
  </div>
</div>

<script>
(function() {
  var baseUrlInput = document.getElementById('aiBaseUrl');
  var apiKeyInput = document.getElementById('aiApiKey');
  var modelSelect = document.getElementById('aiModelSelect');
  var modelInput = document.getElementById('aiModel');
  var fetchBtn = document.getElementById('aiFetchModelsBtn');
  var statusEl = document.getElementById('aiModelStatus');

  if (!modelSelect || !modelInput || !fetchBtn) return;

  function setStatus(msg, kind) {
    if (!statusEl) return;
    if (!msg) { statusEl.style.display = 'none'; statusEl.textContent = ''; return; }
    statusEl.style.display = 'block';
    statusEl.textContent = msg;
    statusEl.style.color = kind === 'error'
      ? 'var(--color-danger, #dc2626)'
      : (kind === 'success' ? 'var(--color-success, #16a34a)' : 'var(--color-text-muted)');
  }

  function showCustomInput(show) {
    modelInput.style.display = show ? 'block' : 'none';
    if (show) modelInput.focus();
  }

  modelSelect.addEventListener('change', function() {
    var val = modelSelect.value;
    if (val === '__custom__') {
      modelInput.value = '';
      showCustomInput(true);
    } else {
      modelInput.value = val;
      showCustomInput(false);
    }
  });

  if (modelSelect.value && modelSelect.value !== '__custom__') {
    showCustomInput(false);
  }

  // Extract model IDs from the various response shapes (OpenAI, Ollama, etc.)
  function extractModelIds(data) {
    var ids = {};
    function push(v) {
      if (typeof v === 'string' && v.trim()) ids[v.trim()] = 1;
      else if (v && typeof v === 'object') {
        if (typeof v.id === 'string' && v.id.trim()) ids[v.id.trim()] = 1;
        else if (typeof v.name === 'string' && v.name.trim()) ids[v.name.trim()] = 1;
      }
    }
    if (Array.isArray(data)) data.forEach(push);
    if (data && Array.isArray(data.data)) data.data.forEach(push);
    if (data && Array.isArray(data.models)) data.models.forEach(push);
    return Object.keys(ids).sort();
  }

  fetchBtn.addEventListener('click', function() {
    var baseUrl = (baseUrlInput.value || '').trim().replace(/\/+$/, '');
    var apiKey = (apiKeyInput.value || '').trim();
    if (!baseUrl || !apiKey) {
      setStatus('<%= t('admin.ai_fetch_need_creds', 'Enter Base URL and API Key first.') %>', 'error');
      return;
    }

    fetchBtn.disabled = true;
    var originalLabel = fetchBtn.textContent;
    fetchBtn.textContent = '<%= t('admin.ai_fetching', 'Fetching...') %>';
    setStatus('<%= t('admin.ai_fetching', 'Fetching...') %>', 'info');

    fetch(baseUrl + '/models', {
      method: 'GET',
      headers: {
        'Authorization': 'Bearer ' + apiKey,
        'Accept': 'application/json'
      }
    })
    .then(function(r) {
      return r.text().then(function(text) {
        if (!r.ok) {
          var msg = 'HTTP ' + r.status;
          try { var j = JSON.parse(text); if (j && (j.error?.message || j.error || j.message)) msg += ': ' + (j.error?.message || j.error || j.message); }
          catch (e) { if (text) msg += ': ' + text.slice(0, 200); }
          throw new Error(msg);
        }
        try { return JSON.parse(text); } catch (e) { throw new Error('Invalid JSON response from API'); }
      });
    })
    .then(function(data) {
      var models = extractModelIds(data);
      if (!models.length) {
        setStatus('<%= t('admin.ai_fetch_empty', 'No models returned by the API.') %>', 'error');
        return;
      }

      var prev = modelInput.value || modelSelect.value;
      modelSelect.innerHTML = '';

      models.forEach(function(id) {
        var opt = document.createElement('option');
        opt.value = id; opt.textContent = id;
        modelSelect.appendChild(opt);
      });

      var customOpt = document.createElement('option');
      customOpt.value = '__custom__';
      customOpt.textContent = '<%= t('admin.ai_model_custom', 'Custom (enter manually)') %>';
      modelSelect.appendChild(customOpt);

      if (prev && models.indexOf(prev) !== -1) {
        modelSelect.value = prev;
        modelInput.value = prev;
      } else {
        modelSelect.value = models[0];
        modelInput.value = models[0];
      }
      showCustomInput(false);

      setStatus(models.length + ' <%= t('admin.ai_models_loaded', 'models loaded.') %>', 'success');
    })
    .catch(function(err) {
      setStatus((err && err.message) ? err.message : '<%= t('admin.ai_connect_failed', 'Failed to connect to AI service.') %>', 'error');
    })
    .finally(function() {
      fetchBtn.disabled = false;
      fetchBtn.textContent = originalLabel;
    });
  });
})();
</script>
