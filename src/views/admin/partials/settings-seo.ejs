<%# Settings: SEO Section %>
<div class="admin-card mb-6">
  <h3 class="admin-card-title"><%= t('admin.seo_settings') %></h3>
  <div class="form-group">
    <label for="seoTitle" class="form-label"><%= t('admin.f_seo_title', 'Homepage Meta Title') %></label>
    <input type="text" id="seoTitle" name="seoTitle" class="input" value="<%= s.seoTitle || '' %>" placeholder="Your Store — Tagline">
  </div>
  <div class="form-group">
    <label for="seoDescription" class="form-label"><%= t('admin.f_seo_desc', 'Homepage Meta Description') %></label>
    <textarea id="seoDescription" name="seoDescription" class="textarea" rows="3" placeholder="<%= t('admin.f_seo_desc_ph', 'Describe your store for search engines...') %>"><%= s.seoDescription || '' %></textarea>
  </div>
  <div class="form-group">
    <label class="form-label"><%= t('admin.f_og_image', 'OG Image') %></label>
    <input type="file" name="seoOgImage" class="input" accept="image/*">
    <span class="form-hint"><%= t('admin.f_og_hint', 'Recommended: 1200×630px. Used when your site is shared on social media.') %></span>
  </div>
</div>
