<%# Admin Settings Page %>
<%
var s = typeof settings !== 'undefined' ? settings : {};
var courierList = typeof couriers !== 'undefined' ? couriers : [];
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Settings' }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'settings' }) %>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <h2>Settings</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;">Configure your store settings.</p>
      </div>
    </div>

    <div class="settings-nav mb-6">
      <a href="/admin/settings" class="btn btn-ghost btn-sm active">General</a>
      <a href="/admin/settings/bank-accounts" class="btn btn-ghost btn-sm">Bank Accounts</a>
      <a href="/admin/settings/taxes" class="btn btn-ghost btn-sm">Tax Rates</a>
      <a href="/admin/settings/currencies" class="btn btn-ghost btn-sm">Currencies</a>
    </div>

    <form action="/admin/settings" method="post" enctype="multipart/form-data">
      <%- include('./partials/settings-store', { s: s }) %>
      <%- include('./partials/settings-api-keys', { s: s }) %>
      <%- include('./partials/settings-smtp', { s: s }) %>
      <%- include('./partials/settings-payment', { s: s }) %>
      <%- include('./partials/settings-shipping', { couriers: courierList }) %>
      <%- include('./partials/settings-seo', { s: s }) %>
      <%- include('./partials/settings-ai', { s: s }) %>

      <div style="padding-top: var(--space-6); border-top: 1px solid var(--color-border-light);">
        <button type="submit" class="btn btn-primary btn-lg">Save All Settings</button>
      </div>
    </form>
  </main>
</div>
</body>
</html>
