<%# Admin Settings: Bank Accounts Page %>
<%
var banks = typeof bankAccounts !== 'undefined' ? bankAccounts : [];
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Bank Accounts' }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'settings' }) %>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <h2>Bank Accounts</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;">Manage bank accounts for manual transfer payments.</p>
      </div>
    </div>

    <div class="settings-nav mb-6">
      <a href="/admin/settings" class="btn btn-ghost btn-sm">General</a>
      <a href="/admin/settings/bank-accounts" class="btn btn-ghost btn-sm active">Bank Accounts</a>
      <a href="/admin/settings/taxes" class="btn btn-ghost btn-sm">Tax Rates</a>
      <a href="/admin/settings/currencies" class="btn btn-ghost btn-sm">Currencies</a>
    </div>

    <!-- Add Bank Account Form -->
    <div class="admin-card mb-6">
      <h3 class="admin-card-title">Add Bank Account</h3>
      <form action="/admin/settings/bank-accounts" method="post" enctype="multipart/form-data">
        <div class="grid" style="grid-template-columns: 1fr 1fr 1fr; gap: var(--space-4);">
          <div class="form-group">
            <label for="bankName" class="form-label form-label-required">Bank Name</label>
            <input type="text" id="bankName" name="bankName" class="input" required placeholder="e.g. BCA">
          </div>
          <div class="form-group">
            <label for="accountNumber" class="form-label form-label-required">Account Number</label>
            <input type="text" id="accountNumber" name="accountNumber" class="input" required placeholder="1234567890">
          </div>
          <div class="form-group">
            <label for="accountHolder" class="form-label form-label-required">Account Holder</label>
            <input type="text" id="accountHolder" name="accountHolder" class="input" required placeholder="Store Name">
          </div>
        </div>
        <div class="form-group">
          <label for="bankLogo" class="form-label">Logo</label>
          <input type="file" id="bankLogo" name="logo" class="input" accept="image/jpeg,image/png">
          <span class="form-hint">JPG, PNG up to 5MB. Optional.</span>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Add Bank Account</button>
      </form>
    </div>

    <!-- Bank Account List -->
    <% if (banks.length > 0) { %>
    <div class="dashboard-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Bank</th>
            <th>Account Number</th>
            <th>Holder</th>
            <th>Status</th>
            <th><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% banks.forEach(function(bank) { %>
          <tr id="bank-row-<%= bank.id %>">
            <td><strong><%= bank.bankName %></strong></td>
            <td style="font: 600 14px/1.3 var(--font-family);"><%= bank.accountNumber %></td>
            <td><%= bank.accountHolder %></td>
            <td>
              <% if (bank.isActive) { %>
              <span class="badge badge-success">Active</span>
              <% } else { %>
              <span class="badge badge-neutral">Inactive</span>
              <% } %>
            </td>
            <td>
              <div class="flex items-center gap-1">
                <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEditBank('<%= bank.id %>')" title="Edit">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <form action="/admin/settings/bank-accounts/<%= bank.id %>/toggle" method="post" style="display:inline;">
                  <button type="submit" class="btn btn-ghost btn-sm" title="Toggle active">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </button>
                </form>
                <form action="/admin/settings/bank-accounts/<%= bank.id %>/delete" method="post" style="display:inline;" onsubmit="return confirm('Delete this bank account?');">
                  <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-danger);" title="Delete">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <tr id="bank-edit-<%= bank.id %>" style="display:none;">
            <td colspan="5">
              <form action="/admin/settings/bank-accounts/<%= bank.id %>" method="post" enctype="multipart/form-data" class="flex flex-col gap-2" style="padding: var(--space-2) 0;">
                <div class="flex items-center gap-3">
                  <input type="text" name="bankName" value="<%= bank.bankName %>" class="input input-sm" required style="width:150px;" placeholder="Bank">
                  <input type="text" name="accountNumber" value="<%= bank.accountNumber %>" class="input input-sm" required style="width:140px;" placeholder="Number">
                  <input type="text" name="accountHolder" value="<%= bank.accountHolder %>" class="input input-sm" required style="width:180px;" placeholder="Holder">
                </div>
                <div class="flex items-center gap-3">
                  <input type="file" name="logo" class="input input-sm" accept="image/jpeg,image/png">
                  <button type="submit" class="btn btn-primary btn-sm">Save</button>
                  <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEditBank('<%= bank.id %>')">Cancel</button>
                </div>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="dashboard-table-wrap">
      <div class="empty-state">
        <h3>No bank accounts</h3>
        <p>Add a bank account above to enable manual transfer payments.</p>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
<script>
function toggleEditBank(id) {
  var editRow = document.getElementById('bank-edit-' + id);
  var row = document.getElementById('bank-row-' + id);
  if (editRow.style.display === 'none' || editRow.style.display === '') {
    editRow.style.display = '';
    row.style.display = 'none';
  } else {
    editRow.style.display = 'none';
    row.style.display = '';
  }
}
</script>
