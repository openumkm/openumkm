<%# Admin Orders List Page — Modern %>
<%
function formatRp(amount) {
  return 'Rp ' + new Intl.NumberFormat('id-ID').format(amount || 0);
}
var orderList = typeof orders !== 'undefined' ? orders : [];
var searchQuery = typeof search !== 'undefined' ? search : '';
var statusFilter = typeof filterStatus !== 'undefined' ? filterStatus : '';
var currentPageNum = typeof page !== 'undefined' ? page : 1;
var totalPages = typeof pages !== 'undefined' ? pages : 1;
var statuses = ['pending', 'waiting_confirmation', 'paid', 'processing', 'shipped', 'completed', 'cancelled', 'expired'];
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('admin.orders') }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'orders' }) %>

  <main class="dashboard-main">
    <div class="admin-topbar">
      <div class="admin-topbar-left">
        <h1 class="admin-page-title"><%= t('admin.orders') %></h1>
        <p class="admin-page-subtitle"><%= t('admin.orders_subtitle', 'Manage and track customer orders.') %></p>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="admin-toolbar">
      <form action="/admin/orders" method="get" class="admin-toolbar-search" style="flex:1;">
        <div class="admin-search-wrap">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" name="q" class="admin-search-input" placeholder="<%= t('admin.search_orders_placeholder', 'Search by order number or customer...') %>" value="<%= searchQuery %>">
        </div>
        <select name="status" class="admin-filter-select">
          <option value=""><%= t('admin.all_statuses', 'All Statuses') %></option>
          <% statuses.forEach(function(s) { %>
          <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= t('admin.' + s, s.replace(/_/g, ' ')) %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn btn-secondary btn-sm"><%= t('admin.filter') %></button>
      </form>
      <div class="admin-toolbar-meta">
        <span class="admin-count-badge"><%= orderList.length %> <%= t('admin.orders').toLowerCase() %></span>
      </div>
    </div>

    <% if (orderList.length > 0) { %>
    <div class="admin-card">
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th><%= t('admin.order_number') %></th>
              <th><%= t('admin.customer') %></th>
              <th><%= t('admin.total') %></th>
              <th><%= t('admin.payment_method') %></th>
              <th><%= t('admin.status') %></th>
              <th><%= t('admin.date', 'Date') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% orderList.forEach(function(order) { %>
            <tr>
              <td><span class="admin-order-num">#<%= order.orderNumber %></span></td>
              <td>
                <div class="admin-customer-cell">
                  <div class="admin-customer-avatar"><%= order.customerName ? order.customerName.charAt(0).toUpperCase() : 'G' %></div>
                  <div>
                    <p class="admin-customer-name"><%= order.customerName || t('admin.guest', 'Guest') %></p>
                    <% if (order.customerEmail) { %>
                    <p class="admin-customer-email"><%= order.customerEmail %></p>
                    <% } %>
                  </div>
                </div>
              </td>
              <td><span class="admin-amount"><%= formatRp(order.total) %></span></td>
              <td>
                <span class="admin-badge <%= order.paymentMethod === 'xendit' ? 'admin-badge-processing' : '' %>" style="<%= order.paymentMethod !== 'xendit' ? 'background: var(--color-gray-100); color: var(--color-gray-600);' : '' %>"><%= order.paymentMethod === 'xendit' ? 'Xendit' : t('admin.transfer', 'Transfer') %></span>
              </td>
              <td>
                <span class="admin-badge admin-badge-<%= order.status %>"><%= t('admin.' + order.status, order.status.replace(/_/g, ' ')) %></span>
              </td>
              <td><span class="admin-date"><%= order.createdAt %></span></td>
              <td>
                <a href="/admin/orders/<%= order.id %>" class="admin-action-btn" title="<%= t('admin.view_detail', 'View detail') %>">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
    <div class="admin-pagination">
      <% if (currentPageNum > 1) { %>
      <a href="/admin/orders?page=<%= currentPageNum - 1 %><%= searchQuery ? '&q=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %>" class="pagination-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <%= t('admin.previous', 'Previous') %>
      </a>
      <% } %>
      <span class="pagination-info"><%= t('admin.page', 'Page') %> <%= currentPageNum %> <%= t('admin.of', 'of') %> <%= totalPages %></span>
      <% if (currentPageNum < totalPages) { %>
      <a href="/admin/orders?page=<%= currentPageNum + 1 %><%= searchQuery ? '&q=' + searchQuery : '' %><%= statusFilter ? '&status=' + statusFilter : '' %>" class="pagination-btn">
        <%= t('admin.next', 'Next') %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <% } %>
    </div>
    <% } %>

    <% } else { %>
    <div class="admin-card">
      <div class="admin-empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <h4><%= t('admin.no_orders_found', 'No orders found') %></h4>
        <p><%= searchQuery || statusFilter ? t('admin.try_adjust_filters', 'Try adjusting your filters.') : t('admin.orders_hint', 'Orders will appear here when customers start placing them.') %></p>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
