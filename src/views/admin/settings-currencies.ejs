<%# Admin Settings: Currencies Page %>
<%
var currencyList = typeof currencies !== 'undefined' ? currencies : [];
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('admin.currencies') }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'settings' }) %>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <h2><%= t('admin.currencies') %></h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;"><%= t('admin.currencies_subtitle', 'Manage available currencies and exchange rates.') %></p>
      </div>
    </div>

    <%- include('./partials/settings-nav', { settingsActive: 'currencies' }) %>

    <% if (currencyList.length > 0) { %>
    <div class="flex flex-col gap-4">
      <% currencyList.forEach(function(cur) { %>
      <div class="admin-card">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--color-primary-light); display: flex; align-items: center; justify-content: center; font: 700 18px/1 var(--font-family); color: var(--color-primary);">
              <%= cur.symbol %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <p style="font: 600 16px/1.3 var(--font-family); margin-bottom: 2px;"><%= cur.code %></p>
                <% if (cur.isDefault) { %>
                <span class="badge badge-primary"><%= t('admin.default_badge', 'Default') %></span>
                <% } %>
                <% if (cur.isActive) { %>
                <span class="badge badge-success"><%= t('admin.product_active') %></span>
                <% } else { %>
                <span class="badge badge-neutral"><%= t('admin.product_inactive') %></span>
                <% } %>
              </div>
              <p style="font: var(--font-label-xs); color: var(--color-text-muted); margin-bottom: 0;"><%= cur.name %></p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <% if (!cur.isDefault) { %>
            <form action="/admin/settings/currencies/<%= cur.code %>/rate" method="post" class="flex items-center gap-2">
              <label style="font: var(--font-label-xs); color: var(--color-text-muted); white-space: nowrap;"><%= t('admin.exchange_rate', 'Exchange Rate') %>:</label>
              <input type="number" name="exchangeRate" class="input" value="<%= cur.exchangeRate %>" step="0.000001" min="0" style="width: 140px;">
              <button type="submit" class="btn btn-secondary btn-sm"><%= t('admin.update', 'Update') %></button>
            </form>
            <% } else { %>
            <span style="font: var(--font-label-sm); color: var(--color-text-muted);"><%= t('admin.base_currency', 'Base currency') %> (1.0)</span>
            <% } %>

            <form action="/admin/settings/currencies/toggle" method="post">
              <input type="hidden" name="code" value="<%= cur.code %>">
              <label class="toggle">
                <input type="checkbox" onchange="this.form.submit()" <%= cur.isActive ? 'checked' : '' %> <%= cur.isDefault ? 'disabled' : '' %>>
                <span class="toggle-track"></span>
              </label>
            </form>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="dashboard-table-wrap">
      <div class="empty-state">
        <h3><%= t('admin.no_currencies', 'No currencies configured') %></h3>
        <p><%= t('admin.no_currencies_hint', 'Currency configuration will be available after initial setup.') %></p>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
