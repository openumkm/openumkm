<%# Admin Settings: Currencies Page %>
<%
var currencyList = typeof currencies !== 'undefined' ? currencies : [];
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Currencies' }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'settings' }) %>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <h2>Currencies</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;">Manage available currencies and exchange rates.</p>
      </div>
    </div>

    <div class="settings-nav mb-6">
      <a href="/admin/settings" class="btn btn-ghost btn-sm">General</a>
      <a href="/admin/settings/bank-accounts" class="btn btn-ghost btn-sm">Bank Accounts</a>
      <a href="/admin/settings/taxes" class="btn btn-ghost btn-sm">Tax Rates</a>
      <a href="/admin/settings/currencies" class="btn btn-ghost btn-sm active">Currencies</a>
    </div>

    <% if (currencyList.length > 0) { %>
    <div class="flex flex-col gap-4">
      <% currencyList.forEach(function(cur) { %>
      <div class="admin-card">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div style="width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--color-primary-light); display: flex; align-items: center; justify-content: center; font: 700 18px/1 var(--font-family); color: var(--color-primary);">
              <%= cur.symbol %>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <p style="font: 600 16px/1.3 var(--font-family); margin-bottom: 2px;"><%= cur.code %></p>
                <% if (cur.isDefault) { %>
                <span class="badge badge-primary">Default</span>
                <% } %>
                <% if (cur.isActive) { %>
                <span class="badge badge-success">Active</span>
                <% } else { %>
                <span class="badge badge-neutral">Inactive</span>
                <% } %>
              </div>
              <p style="font: var(--font-label-xs); color: var(--color-text-muted); margin-bottom: 0;"><%= cur.name %></p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <% if (!cur.isDefault) { %>
            <form action="/admin/settings/currencies/<%= cur.code %>/rate" method="post" class="flex items-center gap-2">
              <label style="font: var(--font-label-xs); color: var(--color-text-muted); white-space: nowrap;">Exchange Rate:</label>
              <input type="number" name="exchangeRate" class="input" value="<%= cur.exchangeRate %>" step="0.000001" min="0" style="width: 140px;">
              <button type="submit" class="btn btn-secondary btn-sm">Update</button>
            </form>
            <% } else { %>
            <span style="font: var(--font-label-sm); color: var(--color-text-muted);">Base currency (1.0)</span>
            <% } %>

            <form action="/admin/settings/currencies/toggle" method="post">
              <input type="hidden" name="code" value="<%= cur.code %>">
              <label class="toggle">
                <input type="checkbox" onchange="this.form.submit()" <%= cur.isActive ? 'checked' : '' %> <%= cur.isDefault ? 'disabled' : '' %>>
                <span class="toggle-track"></span>
              </label>
            </form>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="dashboard-table-wrap">
      <div class="empty-state">
        <h3>No currencies configured</h3>
        <p>Currency configuration will be available after initial setup.</p>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
