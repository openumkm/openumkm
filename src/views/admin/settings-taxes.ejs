<%# Admin Settings: Tax Rates Page %>
<%
var taxes = typeof taxRates !== 'undefined' ? taxRates : [];
var taxOn = typeof taxEnabled !== 'undefined' ? taxEnabled : false;
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('admin.tax_rates') }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'settings' }) %>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <h2><%= t('admin.tax_rates') %></h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;"><%= t('admin.taxes_subtitle', 'Configure tax rates applied at checkout.') %></p>
      </div>
      <label class="toggle">
        <input type="checkbox" id="globalTaxToggle" <%= taxOn ? 'checked' : '' %> disabled>
        <span class="toggle-track"></span>
        <span class="toggle-label"><%= t('admin.tax_enabled', 'Tax Enabled') %></span>
      </label>
    </div>

    <%- include('./partials/settings-nav', { settingsActive: 'taxes' }) %>

    <div class="admin-card mb-6">
      <h3 class="admin-card-title"><%= t('admin.add_tax', 'Add Tax Rate') %></h3>
      <form action="/admin/settings/taxes" method="post">
        <div class="grid" style="grid-template-columns: 2fr 1fr 2fr; gap: var(--space-4);">
          <div class="form-group">
            <label for="taxName" class="form-label form-label-required"><%= t('admin.tax_name_label', 'Name') %></label>
            <input type="text" id="taxName" name="name" class="input" required placeholder="e.g. PPN">
          </div>
          <div class="form-group">
            <label for="taxRate" class="form-label form-label-required"><%= t('admin.tax_rate_label', 'Rate (%)') %></label>
            <input type="number" id="taxRate" name="rate" class="input" required step="0.1" min="0" max="100" placeholder="11.0">
          </div>
          <div class="form-group">
            <label for="taxApplyTo" class="form-label form-label-required"><%= t('admin.tax_apply_to', 'Apply To') %></label>
            <select id="taxApplyTo" name="applyTo" class="select">
              <option value="subtotal"><%= t('admin.tax_subtotal_only', 'Subtotal only') %></option>
              <option value="subtotal_shipping"><%= t('admin.tax_subtotal_shipping', 'Subtotal + Shipping') %></option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><%= t('admin.add_tax', 'Add Tax Rate') %></button>
      </form>
    </div>

    <% if (taxes.length > 0) { %>
    <div class="dashboard-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t('admin.tax_name_label', 'Name') %></th>
            <th><%= t('admin.rate_label', 'Rate') %></th>
            <th><%= t('admin.applied_to_label', 'Applied To') %></th>
            <th><%= t('admin.status') %></th>
            <th><span class="sr-only"><%= t('admin.actions') %></span></th>
          </tr>
        </thead>
        <tbody>
          <% taxes.forEach(function(tax) { %>
          <tr id="tax-row-<%= tax.id %>">
            <td><strong><%= tax.name %></strong></td>
            <td style="font: 600 14px/1.3 var(--font-family);"><%= tax.rate %>%</td>
            <td><%= tax.applyTo === 'subtotal_shipping' ? t('admin.tax_subtotal_shipping') : t('admin.tax_subtotal_only') %></td>
            <td>
              <% if (tax.isActive) { %>
              <span class="badge badge-success"><%= t('admin.product_active') %></span>
              <% } else { %>
              <span class="badge badge-neutral"><%= t('admin.product_inactive') %></span>
              <% } %>
            </td>
            <td>
              <div class="flex items-center gap-1">
                <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEditTax('<%= tax.id %>')" title="<%= t('admin.edit') %>">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <form action="/admin/settings/taxes/<%= tax.id %>/toggle" method="post" style="display:inline;">
                  <button type="submit" class="btn btn-ghost btn-sm" title="<%= t('admin.toggle_active', 'Toggle active') %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </button>
                </form>
                <form action="/admin/settings/taxes/<%= tax.id %>/delete" method="post" style="display:inline;" onsubmit="return confirm('<%= t('admin.delete_tax_confirm', 'Delete this tax rate?') %>');">
                  <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-danger);" title="<%= t('admin.delete') %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <tr id="tax-edit-<%= tax.id %>" style="display:none;">
            <td colspan="5">
              <form action="/admin/settings/taxes/<%= tax.id %>" method="post" class="flex items-center gap-3" style="padding: var(--space-2) 0;">
                <input type="text" name="name" value="<%= tax.name %>" class="input input-sm" required style="width:150px;">
                <input type="number" name="rate" value="<%= tax.rate %>" class="input input-sm" required step="0.1" min="0" max="100" style="width:100px;">
                <select name="applyTo" class="select select-sm">
                  <option value="subtotal" <%= tax.applyTo === 'subtotal' ? 'selected' : '' %>><%= t('admin.tax_subtotal_only', 'Subtotal only') %></option>
                  <option value="subtotal_shipping" <%= tax.applyTo === 'subtotal_shipping' ? 'selected' : '' %>><%= t('admin.tax_subtotal_shipping', 'Subtotal + Shipping') %></option>
                </select>
                <button type="submit" class="btn btn-primary btn-sm"><%= t('admin.save') %></button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEditTax('<%= tax.id %>')"><%= t('admin.cancel') %></button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="dashboard-table-wrap">
      <div class="empty-state">
        <h3><%= t('admin.no_tax_rates', 'No tax rates') %></h3>
        <p><%= t('admin.no_tax_rates_hint', 'Add a tax rate above to apply taxes at checkout.') %></p>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
<script>
function toggleEditTax(id) {
  var editRow = document.getElementById('tax-edit-' + id);
  var row = document.getElementById('tax-row-' + id);
  if (editRow.style.display === 'none' || editRow.style.display === '') {
    editRow.style.display = '';
    row.style.display = 'none';
  } else {
    editRow.style.display = 'none';
    row.style.display = '';
  }
}
</script>
