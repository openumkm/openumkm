<%# Admin Settings: Tax Rates Page %>
<%
var taxes = typeof taxRates !== 'undefined' ? taxRates : [];
var taxOn = typeof taxEnabled !== 'undefined' ? taxEnabled : false;
%>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Tax Rates' }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: typeof userName !== 'undefined' ? userName : 'Admin', adminPage: 'settings' }) %>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <h2>Tax Rates</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;">Configure tax rates applied at checkout.</p>
      </div>
      <label class="toggle">
        <input type="checkbox" id="globalTaxToggle" <%= taxOn ? 'checked' : '' %> disabled>
        <span class="toggle-track"></span>
        <span class="toggle-label">Tax Enabled</span>
      </label>
    </div>

    <div class="settings-nav mb-6">
      <a href="/admin/settings" class="btn btn-ghost btn-sm">General</a>
      <a href="/admin/settings/bank-accounts" class="btn btn-ghost btn-sm">Bank Accounts</a>
      <a href="/admin/settings/taxes" class="btn btn-ghost btn-sm active">Tax Rates</a>
      <a href="/admin/settings/currencies" class="btn btn-ghost btn-sm">Currencies</a>
      <a href="/admin/settings/shipping-methods" class="btn btn-ghost btn-sm">Shipping Methods</a>
    </div>

    <!-- Add Tax Rate Form -->
    <div class="admin-card mb-6">
      <h3 class="admin-card-title">Add Tax Rate</h3>
      <form action="/admin/settings/taxes" method="post">
        <div class="grid" style="grid-template-columns: 2fr 1fr 2fr; gap: var(--space-4);">
          <div class="form-group">
            <label for="taxName" class="form-label form-label-required">Name</label>
            <input type="text" id="taxName" name="name" class="input" required placeholder="e.g. PPN">
          </div>
          <div class="form-group">
            <label for="taxRate" class="form-label form-label-required">Rate (%)</label>
            <input type="number" id="taxRate" name="rate" class="input" required step="0.1" min="0" max="100" placeholder="11.0">
          </div>
          <div class="form-group">
            <label for="taxApplyTo" class="form-label form-label-required">Apply To</label>
            <select id="taxApplyTo" name="applyTo" class="select">
              <option value="subtotal">Subtotal only</option>
              <option value="subtotal_shipping">Subtotal + Shipping</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Add Tax Rate</button>
      </form>
    </div>

    <!-- Tax Rates List -->
    <% if (taxes.length > 0) { %>
    <div class="dashboard-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Rate</th>
            <th>Applied To</th>
            <th>Status</th>
            <th><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% taxes.forEach(function(tax) { %>
          <tr id="tax-row-<%= tax.id %>">
            <td><strong><%= tax.name %></strong></td>
            <td style="font: 600 14px/1.3 var(--font-family);"><%= tax.rate %>%</td>
            <td><%= tax.applyTo === 'subtotal_shipping' ? 'Subtotal + Shipping' : 'Subtotal only' %></td>
            <td>
              <% if (tax.isActive) { %>
              <span class="badge badge-success">Active</span>
              <% } else { %>
              <span class="badge badge-neutral">Inactive</span>
              <% } %>
            </td>
            <td>
              <div class="flex items-center gap-1">
                <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEditTax('<%= tax.id %>')" title="Edit">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <form action="/admin/settings/taxes/<%= tax.id %>/toggle" method="post" style="display:inline;">
                  <button type="submit" class="btn btn-ghost btn-sm" title="Toggle active">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </button>
                </form>
                <form action="/admin/settings/taxes/<%= tax.id %>/delete" method="post" style="display:inline;" onsubmit="return confirm('Delete this tax rate?');">
                  <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-danger);" title="Delete">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <tr id="tax-edit-<%= tax.id %>" style="display:none;">
            <td colspan="5">
              <form action="/admin/settings/taxes/<%= tax.id %>" method="post" class="flex items-center gap-3" style="padding: var(--space-2) 0;">
                <input type="text" name="name" value="<%= tax.name %>" class="input input-sm" required style="width:150px;" placeholder="Name">
                <input type="number" name="rate" value="<%= tax.rate %>" class="input input-sm" required step="0.1" min="0" max="100" style="width:100px;" placeholder="Rate %">
                <select name="applyTo" class="select select-sm">
                  <option value="subtotal" <%= tax.applyTo === 'subtotal' ? 'selected' : '' %>>Subtotal only</option>
                  <option value="subtotal_shipping" <%= tax.applyTo === 'subtotal_shipping' ? 'selected' : '' %>>Subtotal + Shipping</option>
                </select>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEditTax('<%= tax.id %>')">Cancel</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="dashboard-table-wrap">
      <div class="empty-state">
        <h3>No tax rates</h3>
        <p>Add a tax rate above to apply taxes at checkout.</p>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
<script>
function toggleEditTax(id) {
  var editRow = document.getElementById('tax-edit-' + id);
  var row = document.getElementById('tax-row-' + id);
  if (editRow.style.display === 'none' || editRow.style.display === '') {
    editRow.style.display = '';
    row.style.display = 'none';
  } else {
    editRow.style.display = 'none';
    row.style.display = '';
  }
}
</script>
