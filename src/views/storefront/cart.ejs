<%
function formatRp(amount) {
  return 'Rp ' + new Intl.NumberFormat('id-ID').format(amount);
}
var items = (typeof cartItems !== 'undefined' && Array.isArray(cartItems)) ? cartItems : [];
var hasItems = items.length > 0;
var hasOutOfStock = items.some(function(i) { return i.outOfStock; });
var loggedIn = typeof isLoggedIn !== 'undefined' ? isLoggedIn : false;
%>
<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>">
<%- include('../partials/head.ejs', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('storefront.cart') }) %>
<body>
<%- include('../partials/header.ejs', { isLoggedIn: loggedIn, isAdmin: false, cartCount, currentPage: 'cart' }) %>

<main class="cart-page">
  <div class="container">
    <h1 class="mb-8"><%= t('storefront.shopping_cart', 'Shopping Cart') %></h1>

    <% if (!loggedIn) { %>
    <div class="alert alert-info mb-8">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <span><%= t('storefront.signin_save_cart', 'Sign in to save your cart.') %> <a href="/auth/login" style="color:var(--color-primary);font-weight:600"><%= t('storefront.login') %></a></span>
    </div>
    <% } %>

    <% if (hasItems) { %>
    <div class="grid">
      <div class="col-8 md:col-6">
        <table class="cart-table">
          <thead>
            <tr>
              <th><%= t('admin.product', 'Product') %></th>
              <th><%= t('storefront.price') %></th>
              <th><%= t('storefront.quantity') %></th>
              <th><%= t('storefront.cart_subtotal') %></th>
              <th><span class="sr-only"><%= t('admin.actions') %></span></th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(item) { %>
            <tr<%= item.outOfStock ? ' style="opacity:0.6"' : '' %>>
              <td data-label="<%= t('admin.product', 'Product') %>">
                <div class="product-cell">
                  <div class="product-thumb">
                    <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                  </div>
                  <div>
                    <p class="product-name"><a href="/product/<%= item.slug || '#' %>"><%= item.name %></a></p>
                    <% if (item.variant) { %>
                    <p class="product-variant"><%= item.variant %></p>
                    <% } %>
                    <% if (item.outOfStock) { %>
                    <p style="color:var(--color-danger);font-size:13px;font-weight:600;"><%= t('storefront.out_of_stock') %> — <%= t('storefront.remove_to_continue', 'Remove to continue') %></p>
                    <% } else if (item.stockChanged) { %>
                    <p style="color:var(--color-warning,#f59e0b);font-size:13px;"><%= t('storefront.cart_stock_warning') %>: <%= item.stock %> <%= t('storefront.available', 'available') %></p>
                    <% } %>
                  </div>
                </div>
              </td>
              <td data-label="<%= t('storefront.price') %>" class="price-col"><%= formatRp(item.price) %></td>
              <td data-label="<%= t('storefront.quantity') %>">
                <form action="/cart/update" method="post" class="flex items-center">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <div class="qty-selector">
                    <button type="button" class="qty-btn" aria-label="-" onclick="var i=this.nextElementSibling;i.value=Math.max(1,+i.value-1);this.form.submit()">-</button>
                    <input type="number" name="qty" class="qty-input" value="<%= item.qty %>" min="1" readonly>
                    <button type="button" class="qty-btn" aria-label="+" onclick="var i=this.previousElementSibling;i.value=+i.value+1;this.form.submit()">+</button>
                  </div>
                </form>
              </td>
              <td data-label="<%= t('storefront.cart_subtotal') %>" class="subtotal-col"><%= formatRp(item.price * item.qty) %></td>
              <td>
                <form action="/cart/remove" method="post">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <button type="submit" class="remove-btn btn-icon btn-sm" aria-label="<%= t('storefront.cart_remove') %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>

        <div class="mt-6">
          <a href="/" class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            <%= t('storefront.cart_continue') %>
          </a>
        </div>
      </div>

      <div class="col-4 md:col-6">
        <aside class="cart-summary">
          <h3><%= t('storefront.checkout_summary') %></h3>
          <div class="cart-summary-row">
            <span><%= t('storefront.cart_subtotal') %></span>
            <span class="font-semibold"><%= formatRp(typeof subtotal !== 'undefined' ? subtotal : 0) %></span>
          </div>
          <div class="cart-summary-row">
            <span><%= t('storefront.checkout_shipping_cost') %></span>
            <span class="text-muted"><%= t('storefront.calculated_checkout', 'Calculated at checkout') %></span>
          </div>
          <div class="cart-summary-row total">
            <span><%= t('storefront.checkout_total') %></span>
            <span><%= formatRp(typeof subtotal !== 'undefined' ? subtotal : 0) %></span>
          </div>
          <% if (hasOutOfStock) { %>
          <div class="alert alert-warning mt-4" style="background:#fef3c7;color:#92400e;padding:var(--space-3);border-radius:var(--radius-md);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span><%= t('storefront.oos_warning', 'Some items are out of stock. Remove them before checking out.') %></span>
          </div>
          <% } else { %>
          <a href="/checkout" class="btn btn-primary btn-lg">
            <%= t('storefront.cart_checkout') %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <% } %>
        </aside>
      </div>
    </div>
    <% } else { %>
    <div class="cart-empty">
      <div class="empty-state-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      </div>
      <h3><%= t('storefront.cart_empty') %></h3>
      <p><%= t('storefront.cart_empty_hint', 'Discover our collection and find something you love.') %></p>
      <a href="/#products" class="btn btn-primary btn-lg"><%= t('storefront.start_shopping', 'Start Shopping') %></a>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer.ejs') %>
</body>
</html>
