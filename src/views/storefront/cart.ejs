<%#
  Cart Page — storefront
  Variables: pageTitle, cartItems[], subtotal, cartCount, isLoggedIn
%>
<%
function formatRp(amount) {
  return 'Rp ' + new Intl.NumberFormat('id-ID').format(amount);
}
var items = (typeof cartItems !== 'undefined' && Array.isArray(cartItems)) ? cartItems : [];
var hasItems = items.length > 0;
var hasOutOfStock = items.some(function(i) { return i.outOfStock; });
var loggedIn = typeof isLoggedIn !== 'undefined' ? isLoggedIn : false;
%>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs', { pageTitle, metaDescription: 'View and manage items in your shopping cart.' }) %>
<body>
<%- include('../partials/header.ejs', { isLoggedIn, isAdmin: false, cartCount, currentPage: 'cart' }) %>

<main class="cart-page">
  <div class="container">
    <h1 class="mb-8"><%= pageTitle || 'Shopping Cart' %></h1>

    <% if (!loggedIn) { %>
    <div class="alert alert-info mb-8">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <span><strong>Sign in</strong> to save your cart for later and access it from any device. <a href="/auth/login" style="color:var(--color-primary);font-weight:600">Login now</a></span>
    </div>
    <% } %>

    <% if (hasItems) { %>
    <div class="grid">
      <div class="col-8 md:col-6">
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Subtotal</th>
              <th><span class="sr-only">Action</span></th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function(item) { %>
            <tr<%= item.outOfStock ? ' style="opacity:0.6"' : '' %>>
              <td data-label="Product">
                <div class="product-cell">
                  <div class="product-thumb">
                    <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                  </div>
                  <div>
                    <p class="product-name"><a href="/product/<%= item.slug || '#' %>"><%= item.name %></a></p>
                    <% if (item.variant) { %>
                    <p class="product-variant"><%= item.variant %></p>
                    <% } %>
                    <% if (item.outOfStock) { %>
                    <p style="color:var(--color-danger);font-size:13px;font-weight:600;">Out of Stock — Remove to continue</p>
                    <% } else if (item.stockChanged) { %>
                    <p style="color:var(--color-warning,#f59e0b);font-size:13px;">Stock changed: <%= item.stock %> available</p>
                    <% } %>
                  </div>
                </div>
              </td>
              <td data-label="Price" class="price-col"><%= formatRp(item.price) %></td>
              <td data-label="Quantity">
                <form action="/cart/update" method="post" class="flex items-center">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <div class="qty-selector">
                    <button type="button" class="qty-btn" aria-label="Decrease quantity" onclick="var i=this.nextElementSibling;i.value=Math.max(1,+i.value-1);this.form.submit()">-</button>
                    <input type="number" name="qty" class="qty-input" value="<%= item.qty %>" min="1" readonly aria-label="Quantity">
                    <button type="button" class="qty-btn" aria-label="Increase quantity" onclick="var i=this.previousElementSibling;i.value=+i.value+1;this.form.submit()">+</button>
                  </div>
                </form>
              </td>
              <td data-label="Subtotal" class="subtotal-col"><%= formatRp(item.price * item.qty) %></td>
              <td data-label="Action">
                <form action="/cart/remove" method="post">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <button type="submit" class="remove-btn btn-icon btn-sm" aria-label="Remove <%= item.name %> from cart">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                  </button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>

        <div class="mt-6">
          <a href="/" class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Continue Shopping
          </a>
        </div>
      </div>

      <div class="col-4 md:col-6">
        <aside class="cart-summary">
          <h3>Order Summary</h3>
          <div class="cart-summary-row">
            <span>Subtotal</span>
            <span class="font-semibold"><%= formatRp(typeof subtotal !== 'undefined' ? subtotal : 0) %></span>
          </div>
          <div class="cart-summary-row">
            <span>Shipping</span>
            <span class="text-muted">Calculated at checkout</span>
          </div>
          <div class="cart-summary-row total">
            <span>Total</span>
            <span><%= formatRp(typeof subtotal !== 'undefined' ? subtotal : 0) %></span>
          </div>
          <% if (hasOutOfStock) { %>
          <div class="alert alert-warning mt-4" style="background:#fef3c7;color:#92400e;padding:var(--space-3);border-radius:var(--radius-md);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Some items are out of stock. Please remove them before checking out.</span>
          </div>
          <% } else { %>
          <a href="/checkout" class="btn btn-primary btn-lg">
            Proceed to Checkout
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <% } %>
        </aside>
      </div>
    </div>

    <% } else { %>
    <div class="cart-empty">
      <div class="empty-state-icon">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      </div>
      <h3>Your cart is empty</h3>
      <p>Looks like you haven't added anything to your cart yet. Discover our curated collection and find something you love.</p>
      <a href="/#products" class="btn btn-primary btn-lg">Start Shopping</a>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer.ejs') %>
</body>
</html>
