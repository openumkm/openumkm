<%
function formatRp(amount) {
  return 'Rp ' + new Intl.NumberFormat('id-ID').format(amount || 0);
}
var banks = typeof bankAccounts !== 'undefined' ? bankAccounts : [];
var ordNumber = typeof orderNumber !== 'undefined' ? orderNumber : '';
var ordId = typeof orderId !== 'undefined' ? orderId : '';
var totalAmount = typeof total !== 'undefined' ? total : 0;
%>
<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>">
<%- include('../partials/head.ejs', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('storefront.payment_confirm_title') }) %>
<body>
<%- include('../partials/header.ejs', { isLoggedIn, isAdmin: false, cartCount, currentPage: 'payment' }) %>

<main class="payment-confirmation">
  <div class="container" style="max-width:760px">

    <div class="alert alert-success mb-8" style="padding:var(--space-6)">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <div>
        <p style="font:600 18px/1.3 var(--font-family)"><%= t('admin.order', 'Order') %> #<%= ordNumber %> <%= t('storefront.order_created', 'has been created') %>!</p>
        <p style="font:var(--font-body-md);color:#166534"><%= t('storefront.awaiting_payment', 'Your order has been received and is awaiting payment confirmation.') %></p>
      </div>
    </div>

    <p class="mb-6" style="font:var(--font-body-md);color:var(--color-text-secondary)">
      <%= t('storefront.transfer_to') %>
    </p>

    <div class="flex items-baseline gap-3 mb-8 p-6 rounded-lg" style="background:var(--color-surface);border:1px solid var(--color-border)">
      <span class="text-muted" style="font:var(--font-body-md)"><%= t('storefront.total_to_pay', 'Total to pay') %>:</span>
      <span style="font:700 32px/1.2 var(--font-family);color:var(--color-primary)"><%= formatRp(totalAmount) %></span>
    </div>

    <div class="bank-list mb-12">
      <% banks.forEach(function(bank) { %>
      <div class="bank-account" style="cursor:default">
        <div class="bank-logo" style="background:var(--color-primary-light);color:var(--color-primary);font-weight:700"><%= (bank.name || bank.bankName || '').substring(0, 4).toUpperCase() %></div>
        <div class="bank-info">
          <p class="bank-name"><%= bank.name || bank.bankName %></p>
          <p class="bank-number" style="font:600 18px/1.3 var(--font-family);color:var(--color-text);margin-top:var(--space-1)"><%= bank.number || bank.accountNumber %></p>
          <p class="text-muted mt-1" style="font:var(--font-label-xs)"><%= t('admin.account_holder_label', 'Account holder') %>: <%= bank.holder || bank.accountHolder %></p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" onclick="copyToClipboard('<%= bank.number || bank.accountNumber %>', this)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <%= t('storefront.copy', 'Copy') %>
        </button>
      </div>
      <% }); %>
      <% if (banks.length === 0) { %>
      <div class="text-muted p-4 text-center"><%= t('storefront.no_banks_contact', 'No bank accounts available. Please contact customer support.') %></div>
      <% } %>
    </div>

    <section class="mb-12">
      <h2 class="mb-6"><%= t('storefront.payment_confirm_title') %></h2>
      <form action="/payment/confirm" method="post" enctype="multipart/form-data">
        <input type="hidden" name="orderId" value="<%= ordId %>">

        <div class="grid" style="grid-template-columns:1fr 1fr;gap:var(--space-4)">
          <div class="form-group">
            <label for="senderBank" class="form-label form-label-required"><%= t('storefront.payment_confirm_bank') %></label>
            <input type="text" id="senderBank" name="senderBank" class="input" required placeholder="BCA, Mandiri, BNI">
          </div>
          <div class="form-group">
            <label for="senderName" class="form-label form-label-required"><%= t('storefront.payment_confirm_name') %></label>
            <input type="text" id="senderName" name="senderName" class="input" required>
          </div>
        </div>

        <div class="grid" style="grid-template-columns:1fr 1fr;gap:var(--space-4)">
          <div class="form-group">
            <label for="transferAmount" class="form-label form-label-required"><%= t('storefront.payment_confirm_amount') %></label>
            <input type="number" id="transferAmount" name="transferAmount" class="input" required value="<%= totalAmount %>" min="0" step="1">
            <span class="form-hint"><%= t('storefront.must_match_total', 'Must match the total') %>: <strong><%= formatRp(totalAmount) %></strong></span>
          </div>
          <div class="form-group">
            <label for="transferDate" class="form-label form-label-required"><%= t('storefront.payment_confirm_date') %></label>
            <input type="date" id="transferDate" name="transferDate" class="input" required>
          </div>
        </div>

        <div class="form-group mb-6">
          <label class="form-label form-label-required"><%= t('storefront.payment_confirm_receipt') %></label>
          <div class="upload-area" id="uploadZone" tabindex="0" role="button">
            <div class="upload-area-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <p class="upload-area-text"><strong><%= t('admin.click_upload', 'Click to upload') %></strong> <%= t('admin.or_drag_drop', 'or drag and drop') %></p>
            <p class="upload-area-hint">JPG, PNG, PDF — max 5MB</p>
          </div>
          <input type="file" id="receiptFile" name="receipt" accept="image/jpeg,image/png,application/pdf" style="display:none" required>
          <div class="upload-preview" id="uploadPreview"></div>
        </div>

        <div class="form-group mb-8">
          <label for="notes" class="form-label"><%= t('storefront.payment_confirm_notes') %> <span class="text-muted">(<%= t('storefront.optional', 'optional') %>)</span></label>
          <textarea id="notes" name="notes" class="textarea"></textarea>
        </div>

        <div class="payment-timer mb-8">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span><%= t('storefront.payment_deadline_hint', 'Complete payment within 24 hours. Unpaid orders will be automatically cancelled.') %></span>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-full">
          <%= t('storefront.payment_confirm_submit') %>
        </button>
      </form>
    </section>

    <div class="text-center mt-8">
      <a href="/dashboard/orders" class="btn btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <%= t('dashboard.back_to_orders', 'Back to My Orders') %>
      </a>
    </div>

  </div>
</main>

<script>
function copyToClipboard(text, btn) {
  navigator.clipboard.writeText(text).then(function() {
    var original = btn.innerHTML;
    btn.innerHTML = 'Copied!';
    btn.style.color = 'var(--color-success)';
    setTimeout(function() { btn.innerHTML = original; btn.style.color = ''; }, 2000);
  });
}

(function() {
  var uploadZone = document.getElementById('uploadZone');
  var fileInput = document.getElementById('receiptFile');
  var preview = document.getElementById('uploadPreview');
  if (!uploadZone || !fileInput) return;
  uploadZone.addEventListener('click', function() { fileInput.click(); });
  uploadZone.addEventListener('dragover', function(e) { e.preventDefault(); uploadZone.classList.add('drag-over'); });
  uploadZone.addEventListener('dragleave', function() { uploadZone.classList.remove('drag-over'); });
  uploadZone.addEventListener('drop', function(e) {
    e.preventDefault();
    uploadZone.classList.remove('drag-over');
    if (e.dataTransfer.files.length) {
      fileInput.files = e.dataTransfer.files;
      showPreview(e.dataTransfer.files[0]);
    }
  });
  fileInput.addEventListener('change', function() {
    if (fileInput.files.length) showPreview(fileInput.files[0]);
  });
  function showPreview(file) {
    if (!file.type.match(/^(image\/|application\/pdf)/)) return;
    var reader = new FileReader();
    reader.onload = function(ev) {
      preview.innerHTML = '<div class="upload-preview-item"><img src="' + ev.target.result + '" alt=""><button type="button" class="remove-btn" onclick="document.getElementById(\'receiptFile\').value=\'\';document.getElementById(\'uploadPreview\').innerHTML=\'\'">&times;</button></div>';
    };
    reader.readAsDataURL(file);
  }
})();
</script>

<%- include('../partials/footer.ejs') %>
</body>
</html>
