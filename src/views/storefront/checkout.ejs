<%#
  Checkout Page — storefront
  Variables: pageTitle, cartItems[], subtotal, shipping, tax, total, couriers[], bankAccounts[], cartCount, isLoggedIn
%>
<%
function formatRp(amount) {
  return 'Rp ' + new Intl.NumberFormat('id-ID').format(amount || 0);
}
var shippingCost = typeof shipping !== 'undefined' ? shipping : 0;
var taxAmount = typeof tax !== 'undefined' ? tax : 0;
var totalAmount = typeof total !== 'undefined' ? total : ((typeof subtotal !== 'undefined' ? subtotal : 0) + shippingCost + taxAmount);
var courierList = typeof couriers !== 'undefined' ? couriers : [];
var banks = typeof bankAccounts !== 'undefined' ? bankAccounts : [];
var savedAddrs = typeof savedAddresses !== 'undefined' ? savedAddresses : [];
var hasSavedAddrs = savedAddrs.length > 0;
%>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs', { pageTitle, metaDescription: 'Complete your order securely.' }) %>
<body>
<%- include('../partials/header.ejs', { isLoggedIn, isAdmin: false, cartCount, currentPage: 'checkout' }) %>

<main class="checkout-page">
  <div class="container">
    <h1 class="mb-8">Checkout</h1>

    <div class="grid">
      <div class="col-8 md:col-6">
        <div class="checkout-form">
          <form action="/checkout/submit" method="post" id="checkoutForm">

            <% if (hasSavedAddrs) { %>
            <section class="mb-12">
              <h3>0. Saved Addresses</h3>
              <div class="flex flex-col gap-3">
                <% savedAddrs.forEach(function(addr, idx) { %>
                <label class="shipping-method<%= idx === 0 ? ' selected' : '' %>">
                  <input type="radio" name="savedAddressId" value="<%= addr.id %>" <%= idx === 0 ? 'checked' : '' %>>
                  <div class="shipping-method-content" style="width:100%">
                    <p class="shipping-method-name"><%= addr.label %></p>
                    <p class="shipping-method-desc"><%= addr.recipientName %> — <%= addr.phone %> — <%= addr.addressLine %>, <%= addr.city %>, <%= addr.province %>, <%= addr.postalCode %></p>
                  </div>
                </label>
                <% }); %>
                <label class="shipping-method">
                  <input type="radio" name="savedAddressId" value="">
                  <div class="shipping-method-content" style="width:100%">
                    <p class="shipping-method-name">Enter a new address</p>
                  </div>
                </label>
              </div>
            </section>
            <% } %>

            <section class="mb-12">
              <h3>1. Contact Information</h3>
              <div class="form-group">
                <label for="name" class="form-label form-label-required">Full Name</label>
                <input type="text" id="name" name="name" class="input" required placeholder="Enter your full name">
              </div>
              <div class="form-group">
                <label for="email" class="form-label">Email Address <span class="text-muted">(optional)</span></label>
                <input type="email" id="email" name="email" class="input" placeholder="you@example.com">
              </div>
              <div class="form-group">
                <label for="phone" class="form-label form-label-required">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="input" required placeholder="+62 812-3456-7890">
                <span class="form-hint">Used for delivery updates and order confirmations.</span>
              </div>
            </section>

            <section class="mb-12">
              <h3>2. Shipping Address</h3>
              <div class="form-group">
                <label for="address" class="form-label form-label-required">Address</label>
                <textarea id="address" name="addressLine" class="textarea" required placeholder="Street name, building, house number"></textarea>
              </div>
              <div class="form-group">
                <label for="destinationSearch" class="form-label form-label-required">City / District</label>
                <input type="text" id="destinationSearch" class="input" placeholder="Type to search city or district..." autocomplete="off">
                <input type="hidden" id="destinationId" name="destinationId" value="">
                <input type="hidden" id="city" name="city" value="">
                <input type="hidden" id="province" name="province" value="">
                <div id="destinationResults" class="autocomplete-dropdown" style="display:none;"></div>
                <span class="form-hint" id="destinationLabel"></span>
              </div>
              <div class="grid" style="grid-template-columns:1fr 1fr;gap:var(--space-4)">
                <div class="form-group">
                  <label for="postalCode" class="form-label form-label-required">Postal Code</label>
                  <input type="text" id="postalCode" name="postalCode" class="input" required placeholder="12345">
                </div>
                <div class="form-group">
                  <label for="recipientName" class="form-label form-label-required">Recipient Name</label>
                  <input type="text" id="recipientName" name="recipientName" class="input" required placeholder="Recipient name">
                </div>
              </div>
            </section>

            <section class="mb-12">
              <h3>3. Shipping Method</h3>
              <div class="shipping-methods" id="shippingMethods">
                <% if (typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0) { %>
                <% customShippingMethods.forEach(function(m, idx) { %>
                <label class="shipping-method<%= idx === 0 ? ' selected' : '' %>">
                  <input type="radio" name="shippingOption" value="<%= m.cost %>" data-courier="<%= m.name %>" data-service="<%= m.description || m.name %>" <%= idx === 0 ? 'checked' : '' %>>
                  <div class="shipping-method-content">
                    <p class="shipping-method-name"><%= m.name %></p>
                    <p class="shipping-method-desc"><%= m.description || '' %></p>
                  </div>
                  <span class="shipping-method-price"><%= m.cost === 0 ? 'Free' : formatRp(m.cost) %></span>
                </label>
                <% }); %>
                <% } else { %>
                <div class="text-muted p-4" id="shippingPlaceholder">Select a city above to see available shipping options.</div>
                <% } %>
              </div>
              <input type="hidden" name="shippingCost" id="shippingCostInput" value="<%= typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0 ? customShippingMethods[0].cost : 0 %>">
              <input type="hidden" name="courier" id="courierInput" value="<%= typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0 ? customShippingMethods[0].name : '' %>">
              <input type="hidden" name="courierService" id="courierServiceInput" value="<%= typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0 ? (customShippingMethods[0].description || customShippingMethods[0].name) : '' %>">
            </section>

            <section class="mb-12">
              <h3>4. Payment Method</h3>
              <div class="payment-tabs" role="tablist">
                <button type="button" class="payment-tab active" role="tab" aria-selected="true" data-tab="pay-xendit">Online Payment (Xendit)</button>
                <button type="button" class="payment-tab" role="tab" aria-selected="false" data-tab="pay-transfer">Manual Bank Transfer</button>
              </div>

              <div class="payment-tab-content active" id="pay-xendit" role="tabpanel">
                <div class="alert alert-info mb-4">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  <span>After placing your order, you will be redirected to the Xendit payment page to complete payment via bank transfer, virtual account, QRIS, or e-wallet.</span>
                </div>
                <input type="hidden" name="paymentMethod" value="xendit" id="paymentMethodInput">
              </div>

              <div class="payment-tab-content" id="pay-transfer" role="tabpanel">
                <p class="text-secondary mb-4">Transfer the exact amount to one of the following bank accounts:</p>
                <div class="bank-list">
                  <% if (banks.length > 0) { %>
                  <% banks.forEach(function(bank, idx) { %>
                  <label class="bank-account<%= idx === 0 ? ' selected' : '' %>">
                    <input type="radio" name="bankAccount" value="<%= bank.id %>" <%= idx === 0 ? 'checked' : '' %>>
                    <div class="bank-logo"><%= bank.name.substring(0, 3).toUpperCase() %></div>
                    <div class="bank-info">
                      <p class="bank-name"><%= bank.name %></p>
                      <p class="bank-number"><%= bank.number %> &middot; a/n <%= bank.holder %></p>
                    </div>
                  </label>
                  <% }); %>
                  <% } else { %>
                  <div class="text-muted p-4">No bank accounts configured yet.</div>
                  <% } %>
                </div>
                <input type="hidden" name="paymentMethodManual" value="manual_transfer">
              </div>
            </section>

          </form>
        </div>
      </div>

      <aside class="col-4 md:col-6">
        <div class="checkout-summary">
          <h3>Order Summary</h3>
          <% if (typeof cartItems !== 'undefined' && cartItems.length > 0) { %>
          <div class="flex flex-col gap-4 mb-6">
            <% cartItems.forEach(function(item) { %>
            <div class="flex items-center gap-3">
              <div style="width:56px;height:56px;border-radius:var(--radius-md);overflow:hidden;flex-shrink:0;background:var(--color-gray-50)">
                <img src="<%= item.image %>" alt="<%= item.name %>" style="width:100%;height:100%;object-fit:cover">
              </div>
              <div style="flex:1;min-width:0">
                <p class="truncate" style="font:500 14px/1.3 var(--font-family);color:var(--color-text)"><%= item.name %></p>
                <p class="text-muted" style="font:var(--font-label-xs)">Qty: <%= item.qty %></p>
              </div>
              <span style="font:600 14px/1.3 var(--font-family);color:var(--color-text);white-space:nowrap"><%= formatRp(item.price * (item.qty || 1)) %></span>
            </div>
            <% }); %>
          </div>
          <% } %>

          <div class="cart-summary-row">
            <span>Subtotal</span>
            <span class="font-semibold"><%= formatRp(typeof subtotal !== 'undefined' ? subtotal : 0) %></span>
          </div>
          <div class="cart-summary-row">
            <span>Tax (11%)</span>
            <span><%= formatRp(taxAmount) %></span>
          </div>
          <div class="cart-summary-row">
            <span>Shipping</span>
            <span id="shippingSummary"><%= shippingCost > 0 ? formatRp(shippingCost) : 'Select destination' %></span>
          </div>
          <div class="cart-summary-row total">
            <span>Total</span>
            <span id="totalSummary"><%= formatRp(totalAmount) %></span>
          </div>

          <button type="submit" form="checkoutForm" class="btn btn-primary btn-lg w-full">
            Place Order
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>

          <p class="text-muted text-center mt-4" style="font:var(--font-label-xs)">
            By placing this order you agree to our <a href="/terms" style="color:var(--color-primary)">Terms &amp; Conditions</a>.
          </p>
        </div>
      </aside>
    </div>
  </div>
</main>

<script>
(function() {
  var subtotal = <%= typeof subtotal !== 'undefined' ? subtotal : 0 %>;
  var taxAmount = <%= taxAmount %>;
  var selectedShipping = <%= (typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0) ? customShippingMethods[0].cost : 0 %>;
  var initialCourier = '<%= (typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0) ? customShippingMethods[0].name : '' %>';
  var initialService = '<%= (typeof customShippingMethods !== 'undefined' && customShippingMethods.length > 0) ? (customShippingMethods[0].description || customShippingMethods[0].name) : '' %>';

  // ── Saved Addresses ──
  <% if (hasSavedAddrs) { %>
  var savedAddrs = <%- JSON.stringify(savedAddresses || []) %>;
  var addrRadios = document.querySelectorAll('input[name="savedAddressId"]');
  var nameInput = document.getElementById('name');
  var emailInput = document.getElementById('email');
  var phoneInput = document.getElementById('phone');
  var addrLineInput = document.getElementById('address');
  var destSearchInput = document.getElementById('destinationSearch');
  var cityInput = document.getElementById('city');
  var provinceInput = document.getElementById('province');
  var postalInput = document.getElementById('postalCode');
  var recipInput = document.getElementById('recipientName');

  addrRadios.forEach(function(radio) {
    radio.addEventListener('change', function() {
      var addrId = radio.value;
      var addr = savedAddrs.find(function(a) { return a.id === addrId; });
      if (addr) {
        if (recipInput) recipInput.value = addr.recipientName || '';
        if (phoneInput) phoneInput.value = addr.phone || '';
        if (addrLineInput) addrLineInput.value = addr.addressLine || '';
        if (cityInput) cityInput.value = addr.city || '';
        if (provinceInput) provinceInput.value = addr.province || '';
        if (postalInput) postalInput.value = addr.postalCode || '';
        if (destSearchInput) { destSearchInput.value = addr.city || ''; destSearchInput.readOnly = true; }
        if (nameInput) { nameInput.value = addr.recipientName || ''; nameInput.readOnly = true; }
        if (phoneInput) phoneInput.readOnly = true;
        if (addrLineInput) addrLineInput.readOnly = true;
        if (cityInput) cityInput.readOnly = true;
        if (provinceInput) provinceInput.readOnly = true;
        if (postalInput) postalInput.readOnly = true;
      } else {
        // New address mode - unlock all fields
        [nameInput, phoneInput, addrLineInput, cityInput, provinceInput, postalInput, recipInput, destSearchInput].forEach(function(f) {
          if (f) { f.value = ''; f.readOnly = false; }
        });
      }
    });
  });
  <% } %>

  function formatRp(amount) {
    return 'Rp ' + new Intl.NumberFormat('id-ID').format(amount || 0);
  }

  function updateTotal() {
    document.getElementById('shippingSummary').textContent = selectedShipping > 0 ? formatRp(selectedShipping) : 'Select destination';
    document.getElementById('totalSummary').textContent = formatRp(subtotal + taxAmount + selectedShipping);
    document.getElementById('shippingCostInput').value = selectedShipping;
  }

  // ── Destination Search (autocomplete) ──
  var searchInput = document.getElementById('destinationSearch');
  var resultsDiv = document.getElementById('destinationResults');
  var destIdInput = document.getElementById('destinationId');
  var cityInput = document.getElementById('city');
  var provinceInput = document.getElementById('province');
  var destLabel = document.getElementById('destinationLabel');
  var searchTimer = null;

  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimer);
    var q = searchInput.value.trim();
    if (q.length < 2) { resultsDiv.style.display = 'none'; return; }

    searchTimer = setTimeout(function() {
      fetch('/api/shipping/search?q=' + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.results || data.results.length === 0) {
            resultsDiv.innerHTML = '<div class="autocomplete-item text-muted">No results found</div>';
            resultsDiv.style.display = 'block';
            return;
          }
          resultsDiv.innerHTML = data.results.map(function(r) {
            return '<div class="autocomplete-item" data-id="' + r.id + '" data-city="' + r.city + '" data-province="' + r.province + '" data-label="' + r.label + '">' + r.label + '</div>';
          }).join('');
          resultsDiv.style.display = 'block';

          resultsDiv.querySelectorAll('.autocomplete-item').forEach(function(item) {
            item.addEventListener('click', function() {
              var id = item.getAttribute('data-id');
              var city = item.getAttribute('data-city');
              var province = item.getAttribute('data-province');
              var label = item.getAttribute('data-label');

              searchInput.value = label;
              destIdInput.value = id;
              cityInput.value = city;
              provinceInput.value = province;
              destLabel.textContent = label;
              resultsDiv.style.display = 'none';

              // Calculate shipping
              calculateShipping(id);
            });
          });
        });
    }, 300);
  });

  document.addEventListener('click', function(e) {
    if (!resultsDiv.contains(e.target) && e.target !== searchInput) {
      resultsDiv.style.display = 'none';
    }
  });

  // ── Shipping Calculation ──
  function calculateShipping(destinationId) {
    var methodsDiv = document.getElementById('shippingMethods');
    methodsDiv.innerHTML = '<div class="text-muted p-4">Calculating shipping costs...</div>';

    fetch('/api/shipping/calculate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ destination: destinationId })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.services || data.services.length === 0) {
        methodsDiv.innerHTML = '<div class="text-muted p-4">' + (data.error || 'No shipping services available for this destination.') + '</div>';
        selectedShipping = 0;
        updateTotal();
        return;
      }

      methodsDiv.innerHTML = data.services.map(function(svc, idx) {
        return '<label class="shipping-method' + (idx === 0 ? ' selected' : '') + '">' +
          '<input type="radio" name="shippingOption" value="' + svc.cost + '" data-courier="' + svc.courier + '" data-service="' + svc.service + '"' + (idx === 0 ? ' checked' : '') + '>' +
          '<div class="shipping-method-content">' +
            '<p class="shipping-method-name">' + svc.courier + ' — ' + svc.service + '</p>' +
            '<p class="shipping-method-desc">' + (svc.description ? svc.description + ' · ' : '') + 'Est. ' + svc.etd + ' days</p>' +
          '</div>' +
          '<span class="shipping-method-price">' + formatRp(svc.cost) + '</span>' +
        '</label>';
      }).join('');

      // Select first option
      var first = data.services[0];
      selectedShipping = first.cost;
      document.getElementById('courierInput').value = first.courier;
      document.getElementById('courierServiceInput').value = first.service;
      updateTotal();

      // Bind click events
      methodsDiv.querySelectorAll('.shipping-method').forEach(function(method) {
        method.addEventListener('click', function() {
          methodsDiv.querySelectorAll('.shipping-method').forEach(function(m) { m.classList.remove('selected'); });
          method.classList.add('selected');
          var radio = method.querySelector('input[type="radio"]');
          radio.checked = true;
          selectedShipping = parseInt(radio.value, 10);
          document.getElementById('courierInput').value = radio.getAttribute('data-courier');
          document.getElementById('courierServiceInput').value = radio.getAttribute('data-service');
          updateTotal();
        });
      });
    })
    .catch(function() {
      methodsDiv.innerHTML = '<div class="text-muted p-4">Failed to calculate shipping. Please try again.</div>';
    });
  }

  // ── Payment Tabs ──
  var paymentTabs = document.querySelectorAll('.payment-tab');
  paymentTabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      paymentTabs.forEach(function(t) {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      document.querySelectorAll('.payment-tab-content').forEach(function(c) { c.classList.remove('active'); });
      var target = document.getElementById(tab.getAttribute('data-tab'));
      if (target) target.classList.add('active');

      var methodInput = document.getElementById('paymentMethodInput');
      if (methodInput) {
        methodInput.value = tab.getAttribute('data-tab') === 'pay-xendit' ? 'xendit' : 'manual_transfer';
      }
    });
  });

  // ── Bank Account Selection ──
  var bankAccounts = document.querySelectorAll('.bank-account');
  bankAccounts.forEach(function(acct) {
    acct.addEventListener('click', function() {
      bankAccounts.forEach(function(a) { a.classList.remove('selected'); });
      acct.classList.add('selected');
      acct.querySelector('input[type="radio"]').checked = true;
    });
  });
})();
</script>

<%- include('../partials/footer.ejs') %>
</body>
</html>
