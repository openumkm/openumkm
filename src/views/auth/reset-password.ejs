<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('auth.reset_password') }) %>
<body>
<%- include('../partials/header', { isLoggedIn: false, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

<%
const brandName = typeof storeName !== 'undefined' && storeName ? storeName : 'OpenUMKM';
const brandInitial = (brandName.trim()[0] || 'O').toUpperCase();
%>

<main class="auth-page">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="logo">
        <span><%= brandInitial %></span><%= brandName.trim().slice(1) %>
      </div>
      <h2><%= t('auth.set_new_password') %></h2>
      <p><%= t('auth.reset_subtitle') %></p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="/auth/reset-password" method="POST" novalidate>
      <div class="form-group">
        <label for="password" class="form-label form-label-required"><%= t('auth.new_password') %></label>
        <input type="password" id="password" name="password" class="input" placeholder="<%= t('auth.password_min') %>" required minlength="8" autocomplete="new-password" autofocus>
        <span class="form-hint"><%= t('auth.password_min') %></span>
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label form-label-required"><%= t('auth.confirm_password') %></label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="input" placeholder="<%= t('auth.confirm_password_ph', 'Re-enter your new password') %>" required autocomplete="new-password">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;"><%= t('auth.reset_password') %></button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
