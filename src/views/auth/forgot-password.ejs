<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('auth.forgot_password') }) %>
<body>
<%- include('../partials/header', { isLoggedIn: false, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

<%
const brandName = typeof storeName !== 'undefined' && storeName ? storeName : 'OpenUMKM';
const brandInitial = (brandName.trim()[0] || 'O').toUpperCase();
%>

<main class="auth-page">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="logo">
        <span><%= brandInitial %></span><%= brandName.trim().slice(1) %>
      </div>
      <h2><%= t('auth.forgot_password') %></h2>
      <p><%= t('auth.forgot_subtitle') %></p>
    </div>

    <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-success" role="alert">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span><%= message %></span>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="/auth/forgot-password" method="POST" novalidate>
      <div class="form-group">
        <label for="email" class="form-label form-label-required"><%= t('auth.email') %></label>
        <input type="email" id="email" name="email" class="input" placeholder="you@example.com" required autocomplete="email" autofocus>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;"><%= t('auth.send_reset_link') %></button>
    </form>

    <div class="auth-card-footer">
      <a href="/auth/login"><%= t('auth.back_to_login', 'Back to Login') %></a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
