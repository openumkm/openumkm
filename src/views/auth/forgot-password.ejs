<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Forgot Password' }) %>

<body>
<%- include('../partials/header', { isLoggedIn: typeof isLoggedIn !== 'undefined' ? isLoggedIn : false, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

<main class="auth-page">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="logo">
        <span>S</span>wift Commerce
      </div>
      <h2>Forgot Password</h2>
      <p>Enter your email and we'll send you a reset link</p>
    </div>

    <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-success" role="alert">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <span><%= message %></span>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="/auth/forgot-password" method="POST" novalidate>
      <div class="form-group">
        <label for="email" class="form-label form-label-required">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          class="input"
          placeholder="you@example.com"
          required
          autocomplete="email"
          autofocus
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
    </form>

    <div class="auth-card-footer">
      <a href="/auth/login">Back to Login</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
