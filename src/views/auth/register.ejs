<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('auth.register') }) %>
<body>
<%- include('../partials/header', { isLoggedIn: false, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

<%
const brandName = typeof storeName !== 'undefined' && storeName ? storeName : 'OpenUMKM';
const brandInitial = (brandName.trim()[0] || 'O').toUpperCase();
%>

<main class="auth-page">
  <div class="auth-card">
    <div class="auth-card-header">
      <div class="logo">
        <span><%= brandInitial %></span><%= brandName.trim().slice(1) %>
      </div>
      <h2><%= t('auth.create_account', 'Create Account') %></h2>
      <p><%= t('auth.join_today', 'Join') %> <%= brandName %> <%= t('auth.today_suffix', 'today') %></p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span><%= error %></span>
    </div>
    <% } %>

    <form action="/auth/register" method="POST" novalidate>
      <div class="form-group">
        <label for="fullName" class="form-label form-label-required"><%= t('auth.full_name') %></label>
        <input type="text" id="fullName" name="fullName" class="input" placeholder="Jane Doe" required autocomplete="name" autofocus>
      </div>

      <div class="form-group">
        <label for="email" class="form-label form-label-required"><%= t('auth.email') %></label>
        <input type="email" id="email" name="email" class="input" placeholder="you@example.com" required autocomplete="email">
      </div>

      <div class="form-group">
        <label for="phone" class="form-label form-label-required"><%= t('auth.phone') %></label>
        <input type="tel" id="phone" name="phone" class="input" placeholder="+62 812 3456 7890" required autocomplete="tel">
      </div>

      <div class="form-group">
        <label for="password" class="form-label form-label-required"><%= t('auth.password') %></label>
        <input type="password" id="password" name="password" class="input" placeholder="<%= t('auth.password_min') %>" required minlength="8" autocomplete="new-password">
        <span class="form-hint"><%= t('auth.password_min') %></span>
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label form-label-required"><%= t('auth.confirm_password') %></label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="input" placeholder="<%= t('auth.confirm_password_ph', 'Re-enter your password') %>" required autocomplete="new-password">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;"><%= t('auth.create_account', 'Create Account') %></button>
    </form>

    <div class="auth-card-footer">
      <%= t('auth.has_account') %> <a href="/auth/login"><%= t('auth.login') %></a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
