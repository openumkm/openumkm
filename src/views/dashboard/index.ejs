<% const userNameVal = typeof userName !== 'undefined' ? userName : 'Customer'; %>
<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : t('dashboard.my_dashboard') }) %>
<body>
<div class="dashboard-layout">
  <%- include('./partials/sidebar', { userName: userNameVal, dashboardPage: 'dashboard' }) %>

  <main class="dashboard-main" id="dashboardMain">
    <div class="dashboard-header">
      <div>
        <h2><%= t('dashboard.welcome') %>, <%= userNameVal %></h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;"><%= t('dashboard.dashboard_hint', "Here's what's happening with your orders.") %></p>
      </div>
    </div>

    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-card-icon primary">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div class="stat-card-label"><%= t('dashboard.total_orders') %></div>
        <div class="stat-card-value"><%= typeof stats !== 'undefined' && stats ? stats.totalOrders || 0 : 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon warning">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-card-label"><%= t('dashboard.pending_orders') %></div>
        <div class="stat-card-value"><%= typeof stats !== 'undefined' && stats ? stats.pendingOrders || 0 : 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon success">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-card-label"><%= t('dashboard.completed_orders') %></div>
        <div class="stat-card-value"><%= typeof stats !== 'undefined' && stats ? stats.completedOrders || 0 : 0 %></div>
      </div>
    </div>

    <div class="dashboard-table-wrap">
      <div class="dashboard-table-header">
        <h3><%= t('dashboard.recent_orders') %></h3>
      </div>
      <% if (typeof recentOrders !== 'undefined' && recentOrders && recentOrders.length > 0) { %>
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t('dashboard.order_number') %></th>
            <th><%= t('dashboard.date') %></th>
            <th><%= t('dashboard.status') %></th>
            <th><%= t('dashboard.total') %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% recentOrders.forEach(function(order) { %>
          <tr>
            <td><strong>#<%= order.orderNumber || order.id %></strong></td>
            <td><%= order.createdAt ? new Date(order.createdAt).toLocaleDateString(currentLang === 'id' ? 'id-ID' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></td>
            <td>
              <span class="status <%= 'status-' + ((order.status || '').toLowerCase()) %>"><%= t('admin.' + (order.status || 'pending'), order.status || 'Pending') %></span>
            </td>
            <td class="amount">Rp <%= order.total ? order.total.toLocaleString('id-ID') : '0' %></td>
            <td><a href="/dashboard/orders/<%= order.id %>" style="color: var(--color-primary); font: var(--font-label-sm); font-weight: 600;"><%= t('dashboard.view_detail') %></a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <h3><%= t('dashboard.no_orders') %></h3>
        <p><%= t('dashboard.no_orders_hint', 'When you place an order, it will appear here.') %></p>
      </div>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
