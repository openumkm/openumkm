<% const userNameVal = typeof userName !== 'undefined' ? userName : 'Customer'; %>

<%- include('../partials/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'My Addresses' }) %>

<body>
<div class="dashboard-layout">
  <aside class="dashboard-sidebar" aria-label="Dashboard navigation">
    <div class="dashboard-sidebar-logo">
      <span>S</span>wift Commerce
    </div>

    <div class="flex items-center gap-3" style="padding: var(--space-3); background: var(--color-gray-50); border-radius: var(--radius-md); margin-bottom: var(--space-6);">
      <div class="avatar" style="width: 44px; height: 44px; font-size: 16px;" aria-hidden="true"><%= userNameVal.charAt(0).toUpperCase() %></div>
      <div>
        <p style="font: var(--font-label-sm); color: var(--color-text); margin-bottom: 0;"><%= userNameVal %></p>
        <p style="font: var(--font-label-xs); color: var(--color-text-muted);">Customer</p>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="Dashboard menu">
      <a href="/dashboard" class="sidebar-nav-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/dashboard/orders" class="sidebar-nav-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        My Orders
      </a>
      <a href="/dashboard/addresses" class="sidebar-nav-item active">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Addresses
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/auth/logout" class="sidebar-nav-item" style="color: var(--color-danger);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </div>
  </aside>

  <main class="dashboard-main">
    <div class="dashboard-header">
      <h2>My Addresses</h2>
      <a href="/dashboard/addresses/add" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add New Address
      </a>
    </div>

    <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) { %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6);">
      <% addresses.forEach(function(addr) { %>
      <div style="background: var(--color-surface); border: 1px solid var(--color-border-light); border-radius: var(--radius-lg); padding: var(--space-6); position: relative;">
        <div class="flex items-center gap-2" style="margin-bottom: var(--space-4);">
          <span class="badge badge-primary"><%= addr.label || 'Home' %></span>
          <% if (addr.isDefault) { %>
          <span class="badge badge-success">Default</span>
          <% } %>
        </div>

        <h4 style="margin-bottom: var(--space-2);"><%= addr.name %></h4>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-1);"><%= addr.phone %></p>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          <%= addr.address %><br>
          <%= addr.city %><%= addr.state ? ', ' + addr.state : '' %> <%= addr.postalCode || '' %>
        </p>

        <div class="flex gap-2">
          <a href="/dashboard/addresses/<%= addr.id %>/edit" class="btn btn-ghost btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          <form action="/dashboard/addresses/<%= addr.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this address?');">
            <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-danger);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              Delete
            </button>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="dashboard-table-wrap">
      <div class="empty-state">
        <div class="empty-state-icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3>No addresses saved</h3>
        <p>Add a shipping address to make checkout faster.</p>
        <a href="/dashboard/addresses/add" class="btn btn-primary">Add New Address</a>
      </div>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
