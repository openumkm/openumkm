<%- include('partials/head', { pageTitle: t('storefront.page_not_found', '404 — Page Not Found') }) %>
<body>
<div class="dashboard-layout" style="display:flex; align-items:center; justify-content:center; min-height:100vh;">
  <main style="text-align:center; max-width:480px; padding:var(--space-10);">
    <div style="font-size:96px; font-weight:800; color:var(--color-primary); line-height:1; margin-bottom:var(--space-4);">404</div>
    <h1 style="margin-bottom:var(--space-3);"><%= t('storefront.page_not_found', 'Page Not Found') %></h1>
    <p style="color:var(--color-text-secondary); margin-bottom:var(--space-6);">
      <% if (typeof error !== 'undefined' && error) { %>
        <%= error %>
      <% } else { %>
        <%= t('storefront.page_not_found_msg', 'The page you are looking for does not exist or has been moved.') %>
      <% } %>
    </p>
    <a href="/" class="btn btn-primary"><%= t('storefront.back_to_home', 'Back to Home') %></a>
  </main>
</div>
</body>
</html>
