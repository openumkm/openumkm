<%# Header partial - ghost navbar %>
<%
  const loggedIn = typeof isLoggedIn !== 'undefined' ? isLoggedIn : false;
  const admin = typeof isAdmin !== 'undefined' ? isAdmin : false;
  const cartQty = typeof cartCount !== 'undefined' ? cartCount : 0;
  const page = typeof currentPage !== 'undefined' ? currentPage : '';
  const locale = typeof currentLang !== 'undefined' ? currentLang : 'en';
  const currCode = typeof currency !== 'undefined' ? currency : 'IDR';
  const brandName = typeof storeName !== 'undefined' && storeName ? storeName : 'OpenUMKM';
  const brandInitial = (brandName.trim()[0] || 'O').toUpperCase();
%>

<header class="header-ghost" id="mainHeader">
  <div class="container">
    <a href="/" class="header-logo" aria-label="<%= brandName %> Home">
      <span class="header-logo-icon"><%= brandInitial %></span>
      <span><%= brandName %></span>
    </a>

    <nav class="header-nav" aria-label="Main navigation">
      <a href="/" class="header-nav-link<%= page === 'home' ? ' active' : '' %>"><%= t('storefront.home') %></a>
      <a href="/#products" class="header-nav-link<%= page === 'products' ? ' active' : '' %>"><%= t('storefront.products') %></a>
    </nav>

    <div class="header-actions">
      <div class="lang-switcher">
        <a href="/?lang=id<%= currCode !== 'IDR' ? '&currency=' + currCode : '' %>" class="<%= locale === 'id' ? 'active' : '' %>">ID</a>
        <span class="lang-sep">|</span>
        <a href="/?lang=en<%= currCode !== 'IDR' ? '&currency=' + currCode : '' %>" class="<%= locale === 'en' ? 'active' : '' %>">EN</a>
        <% if (typeof currencies !== 'undefined' && currencies.length > 1) { %>
        <span class="lang-sep">·</span>
        <select onchange="var v=this.value;var u=new URL(location);u.searchParams.set('currency',v);location.href=u.toString()" style="border:none;background:transparent;font:var(--font-label-sm);color:var(--color-text-muted);cursor:pointer;padding:0 2px;">
          <% currencies.forEach(function(c) { %>
          <option value="<%= c.code %>" <%= c.code === currCode ? 'selected' : '' %>><%= c.symbol %> <%= c.code %></option>
          <% }); %>
        </select>
        <% } %>
      </div>

      <a href="/?search=1" class="header-action-btn" aria-label="<%= t('storefront.search') %>" title="<%= t('storefront.search') %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>

      <a href="/cart" class="header-action-btn" aria-label="<%= t('storefront.cart') %>" title="<%= t('storefront.cart') %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <% if (cartQty > 0) { %>
        <span class="badge"><%= cartQty > 99 ? '99+' : cartQty %></span>
        <% } %>
      </a>

      <% if (loggedIn) { %>
      <div class="header-dropdown">
        <button class="header-action-btn" aria-label="<%= t('storefront.account') %>" title="<%= t('storefront.account') %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>
        <div class="header-dropdown-menu">
          <a href="/dashboard" class="header-dropdown-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <%= t('dashboard.my_dashboard') %>
          </a>
          <a href="/dashboard/orders" class="header-dropdown-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <%= t('dashboard.my_orders') %>
          </a>
          <a href="/dashboard/addresses" class="header-dropdown-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= t('dashboard.addresses') %>
          </a>
          <% if (admin) { %>
          <div class="header-dropdown-divider"></div>
          <a href="/admin" class="header-dropdown-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/></svg>
            <%= t('admin.admin_panel') %>
          </a>
          <% } %>
          <div class="header-dropdown-divider"></div>
          <a href="/auth/logout" class="header-dropdown-item danger">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <%= t('storefront.logout') %>
          </a>
        </div>
      </div>
      <% } else { %>
      <a href="/auth/login" class="btn btn-ghost btn-sm"><%= t('storefront.login') %></a>
      <a href="/auth/register" class="btn btn-primary btn-sm"><%= t('storefront.register') %></a>
      <% } %>

      <button class="header-hamburger" id="menuToggle" aria-label="Toggle menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-menu" id="mobileMenu" aria-label="Mobile navigation">
  <a href="/" class="mobile-menu-link"><%= t('storefront.home') %></a>
  <a href="/#products" class="mobile-menu-link"><%= t('storefront.products') %></a>
  <a href="/cart" class="mobile-menu-link"><%= t('storefront.cart') %> <% if (cartQty > 0) { %><span class="badge"><%= cartQty %></span><% } %></a>
  <div class="divider"></div>
  <div class="flex gap-2 px-4 py-2">
    <a href="/?lang=id" class="btn btn-ghost btn-sm<%= locale === 'id' ? ' active' : '' %>">Bahasa Indonesia</a>
    <a href="/?lang=en" class="btn btn-ghost btn-sm<%= locale === 'en' ? ' active' : '' %>">English</a>
  </div>
  <div class="divider"></div>
  <% if (loggedIn) { %>
  <a href="/dashboard" class="mobile-menu-link"><%= t('dashboard.my_dashboard') %></a>
  <a href="/dashboard/orders" class="mobile-menu-link"><%= t('dashboard.my_orders') %></a>
  <a href="/dashboard/addresses" class="mobile-menu-link"><%= t('dashboard.addresses') %></a>
  <% if (admin) { %>
  <a href="/admin" class="mobile-menu-link"><%= t('admin.admin_panel') %></a>
  <% } %>
  <a href="/auth/logout" class="mobile-menu-link" style="color: var(--color-danger)"><%= t('storefront.logout') %></a>
  <% } else { %>
  <a href="/auth/login" class="mobile-menu-link"><%= t('storefront.login') %></a>
  <a href="/auth/register" class="mobile-menu-link"><%= t('storefront.register') %></a>
  <% } %>
</nav>

<script>
(function() {
  var header = document.getElementById('mainHeader');
  var toggle = document.getElementById('menuToggle');
  var menu = document.getElementById('mobileMenu');
  if (!header || !toggle || !menu) return;
  window.addEventListener('scroll', function() {
    if (window.scrollY > 10) header.classList.add('scrolled');
    else header.classList.remove('scrolled');
  });
  toggle.addEventListener('click', function() {
    var open = menu.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  var mobileLinks = menu.querySelectorAll('.mobile-menu-link');
  for (var i = 0; i < mobileLinks.length; i++) {
    mobileLinks[i].addEventListener('click', function() {
      menu.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  }
})();
</script>
