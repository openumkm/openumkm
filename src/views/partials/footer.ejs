<%# Footer partial %>
<%
  const brandName = typeof storeName !== 'undefined' && storeName ? storeName : 'OpenUMKM';
  const brandInitial = (brandName.trim()[0] || 'O').toUpperCase();
%>
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand-logo">
          <span class="header-logo-icon"><%= brandInitial %></span>
          <span><%= brandName %></span>
        </div>
        <p class="footer-tagline">
          <%= t('storefront.footer_tagline', 'Modern online store with curated products and a seamless shopping experience.') %>
        </p>
      </div>

      <div>
        <h4 class="footer-heading"><%= t('storefront.quick_links', 'Quick Links') %></h4>
        <div class="footer-links">
          <a href="/"><%= t('storefront.home') %></a>
          <a href="/#products"><%= t('storefront.products') %></a>
          <a href="/cart"><%= t('storefront.cart') %></a>
        </div>
      </div>

      <div>
        <h4 class="footer-heading"><%= t('storefront.customer_service', 'Customer Service') %></h4>
        <div class="footer-links">
          <a href="/dashboard/orders"><%= t('storefront.track_order', 'Track Order') %></a>
        </div>
      </div>

      <div>
        <h4 class="footer-heading"><%= t('storefront.account') %></h4>
        <div class="footer-links">
          <a href="/dashboard"><%= t('dashboard.my_dashboard') %></a>
          <a href="/dashboard/orders"><%= t('dashboard.my_orders') %></a>
          <a href="/dashboard/addresses"><%= t('dashboard.addresses') %></a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; <%= new Date().getFullYear() %> <%= brandName %>. <%= t('storefront.rights_reserved', 'All rights reserved.') %>
      </p>
    </div>
  </div>
</footer>

<script>
(function() {
  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }
  var token = getCookie('_csrf');
  if (!token) return;
  document.querySelectorAll('form[method="post"]').forEach(function(form) {
    if (form.querySelector('input[name="_csrf"]')) return;
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = '_csrf';
    input.value = token;
    form.appendChild(input);
  });
})();
</script>
